bind 0.0.0.0                     # Tüm arayüzlerde dinle
protected-mode no                # Korumalı mod kapalı
port 6379                        # Standart Redis portu
timeout 300                      # Boş bağlantı zaman aşımı
tcp-keepalive 60                 # TCP keepalive aralığı
maxmemory 512mb                  # Maksimum bellek kullanımı
maxmemory-policy allkeys-lru     # LRU ile eski anahtar at
